PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/attendance
DB_SSL=false
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3500,http://localhost:3000,http://localhost:3001
OFFICE_LATITUDE=22.5726
OFFICE_LONGITUDE=88.3639
OFFICE_RADIUS=100
FACE_CONFIDENCE_THRESHOLD=0.85

# Chapa — use SECRET key from dashboard.chapa.co → Settings → API (NOT the public CHAPUBK key)
CHAPA_SECRET_KEY=CHASECK_TEST-your-secret-key-here
CHAPA_BASE_URL=https://api.chapa.co/v1
